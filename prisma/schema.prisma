generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  niche        String   @default("")
  brandSummary String   @default("") @db.Text
  audience     String   @default("") @db.Text
  brandVisualStyle String @default("") @db.Text
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appConfig     AppConfig?
  adminUsers    AdminUser[]
  messages      MessageLog[]
  memorySessions MemorySession[]
  memoryMessages MemoryMessage[]
  webhookEvents  WebhookEvent[]
  blastTemplates BlastTemplate[]
  blastCampaigns BlastCampaign[]

  @@index([isDefault])
}

model AppConfig {
  id                  Int      @id @default(autoincrement())
  businessId          String   @unique
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  aiAutoReplyEnabled  Boolean  @default(true)
  creatorGenerationEnabled Boolean @default(true)
  aiApiUrl            String
  aiApiKey            String
  aiModel             String
  promptSystem        String   @db.Text
  waApiUrl            String
  waSessionId         String
  waToken             String
  waMasterKey         String
  mongodbUri          String
  mongodbDb           String
  ragCollection       String
  ragIndexName        String
  embeddingProvider   String
  embeddingApiKey     String
  embeddingModel      String
  embeddingDimensions String
  embeddingBaseUrl    String
  imageProvider       String   @default("byteplus")
  bytePlusApiKey      String   @default("")
  bytePlusBaseUrl     String   @default("https://ark.ap-southeast.bytepluses.com/api/v3")
  bytePlusImageModel  String   @default("seedream-4-5-251128")
  r2AccessKey         String   @default("")
  r2SecretKey         String   @default("")
  r2Bucket            String   @default("")
  r2Endpoint          String   @default("")
  r2PublicUrl         String   @default("")
  topicScoutSearchApiKey String @default("")
  topicScoutSearchUrl  String  @default("https://search.infoquest.bytepluses.com")
  topicScoutModelApiKey String @default("")
  topicScoutModelBaseUrl String @default("https://ark.ap-southeast.bytepluses.com/api/v3")
  topicScoutModel      String  @default("seed-2-0-mini-260215")
  topicScoutDefaultQuery String @default("tren terbaru hotel indonesia direct booking OTA website hotel AI customer service hospitality marketing")
  metaAppId           String   @default("")
  metaAppSecret       String   @default("")
  metaGraphVersion    String   @default("v23.0")
  metaFacebookPageId  String   @default("")
  metaFacebookPageName String  @default("")
    metaInstagramBusinessId String @default("")
    metaInstagramUsername String @default("")
    metaPageAccessToken String   @default("")
    metaPageTokenExpiresAt String @default("")
    threadsAppId        String   @default("")
    threadsAppSecret    String   @default("")
    threadsUserId        String   @default("")
    threadsUsername      String   @default("")
    threadsAccessToken   String   @default("")
  threadsTokenExpiresAt String  @default("")
  threadsApiVersion    String   @default("v1.0")
  threadsApiBaseUrl    String   @default("https://graph.threads.net")
  linkedinClientId    String   @default("")
  linkedinClientSecret String  @default("")
  linkedinRedirectUri String   @default("")
  linkedinAccessToken String   @default("")
  linkedinRefreshToken String  @default("")
  linkedinTokenExpiresAt String @default("")
  linkedinAuthorUrn   String   @default("")
  linkedinOrganizationUrn String @default("")
  linkedinApiVersion  String   @default("202504")
  autoPostEnabled     Boolean  @default(false)
  schedulerSecret     String   @default("")
  seoKeywordEnabled   Boolean  @default(true)
  seoKeywordList      String   @default("") @db.Text
  // Threads Scout
  threadsScoutEnabled          Boolean  @default(false)
  threadsScoutKeywords         String   @default("") @db.Text
  threadsScoutPersona          String   @default("") @db.Text
  threadsScoutSellAngle        String   @default("") @db.Text
  threadsScoutLimitPerKeyword  String   @default("20")
  threadsScoutMaxRepliesPerRun String   @default("5")
  threadsScoutRepliedIds       String   @default("") @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([waSessionId])
}

model AdminUser {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
}

model MessageLog {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromPhone  String
  message    String   @db.Text
  reply      String   @db.Text
  source     String
  status     String
  intent     String
  createdAt  DateTime @default(now())
  error      String?  @db.Text

  @@index([businessId, createdAt])
  @@index([businessId, fromPhone])
}

model MemorySession {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phone      String
  summary    String   @default("") @db.Text
  lastActive DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  messages   MemoryMessage[]

  @@id([businessId, phone])
  @@index([businessId, lastActive])
}

model MemoryMessage {
  id         String        @id @default(uuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phone      String
  role       String
  content    String        @db.Text
  createdAt  DateTime      @default(now())
  session    MemorySession @relation(fields: [businessId, phone], references: [businessId, phone], onDelete: Cascade)

  @@index([businessId, phone, createdAt])
}

model WebhookEvent {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  stage      String
  fromPhone  String?
  message    String?  @db.Text
  reason     String?  @db.Text
  payload    Json?
  rawBody    String?  @db.Text
  headers    Json?

  @@index([businessId, createdAt])
  @@index([businessId, stage])
}

// --- Auto Blast Feature ---

model BlastTemplate {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  text        String   @db.Text
  imageUrl    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaignItems BlastCampaignItem[]

  @@index([businessId])
}

model BlastCampaign {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  status          String   @default("draft") // draft | active | paused | completed
  targetType      String   @default("whatsapp_group") // whatsapp_group | whatsapp_individual | social
  socialPlatforms String[] @default([]) // threads, instagram, facebook, linkedin
  intervalMinutes Int      @default(60) // delay between template sequence items
  startAt         DateTime?
  endDate         DateTime?   // auto-stop campaign after this date
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  targets       BlastCampaignTarget[]
  items         BlastCampaignItem[]
  executionLogs BlastExecutionLog[]

  @@index([businessId, status])
}

model BlastCampaignTarget {
  id         String       @id @default(uuid())
  campaignId String
  campaign   BlastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetId   String       // WA group ID (628xxx@g.us) or phone number
  label      String       @default("") // friendly name for the target

  @@index([campaignId])
}

model BlastCampaignItem {
  id         String        @id @default(uuid())
  campaignId String
  campaign   BlastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  templateId String
  template   BlastTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder  Int           @default(0) // execution order
  delayAfterMinutes Int    @default(0) // delay after previous item (0 = run immediately in sequence)

  @@index([campaignId, sortOrder])
}

model BlastExecutionLog {
  id         String        @id @default(uuid())
  campaignId String
  campaign   BlastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  itemId     String?
  targetId   String?
  templateId String?
  targetLabel String       @default("")
  platform   String        @default("whatsapp") // whatsapp | threads | instagram | facebook | linkedin
  status     String        @default("pending") // pending | success | failed
  message    String?       @db.Text
  error      String?       @db.Text
  createdAt  DateTime      @default(now())

  @@index([campaignId, createdAt])
  @@index([campaignId, status])
}
